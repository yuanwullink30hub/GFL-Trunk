# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (monorepo: match at any depth, not just root)
node_modules/
.pnp
.pnp.js

# testing
coverage/

# build output
build/
dist/
dist-app/

# monorepo tooling
.turbo/
.vite/

# misc
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
backend/.env

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local profiling scratch (Firefox profiles + analyzer)
tmp/

# Local data exports — contain personal data in the clear, never commit
exports/

# Desktop app: synced UI copy and packaged installers
apps/desktop/ui/
apps/desktop/release/
# …but its build resources (the app icon) are source, not output
!apps/desktop/build/
# Management app: same layout
apps/admin-desktop/ui/
apps/admin-desktop/release/
!apps/admin-desktop/build/

# Archetype portrait originals (20-30 MB PNG, over Cloudflare Pages' 25 MiB per-file limit): only their
# web/, full/ and depth/ copies ship (packages/assessment-core/src/data/archetypeImages.js).
apps/platform/public/images/Archetype imags/*.png
