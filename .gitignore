# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (monorepo: match at any depth, not just root)
node_modules/
.pnp
.pnp.js

# testing
coverage/

# build output
build/
dist/
dist-app/

# monorepo tooling
.turbo/
.vite/

# misc
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
backend/.env

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local profiling scratch (Firefox profiles + analyzer)
tmp/

# Local data exports — contain personal data in the clear, never commit
exports/

# Desktop app: synced UI copy and packaged installers
apps/desktop/ui/
apps/desktop/release/
# …but its build resources (the app icon) are source, not output
!apps/desktop/build/
# Management app: same layout
apps/admin-desktop/ui/
apps/admin-desktop/release/
!apps/admin-desktop/build/

# Everything about the archetype portraits that must NOT be deployed. Vite copies apps/platform/public/
# into the build straight off the disk and .gitignore has no say in it, so the heavy tiers live at the
# repo root in portraits/ instead — see scripts/ingest-archetype-portraits.mjs for the full layout:
#   portraits/_incoming/  what a delivery handed over (the ingest's input)
#   portraits/_masters/   the ~23 MB PNG originals: archival + the source for the depth-map pass
#   portraits/print/      2764 px, the PDF cover      } published to R2, ~660 MB together
#   portraits/full/       the delivered resolution     } (scripts/publish-portraits.mjs)
# Only web/ (~31 MB) and depth/ live under public/ and ship with the site.
/portraits/
# A master dropped at the top of the shipped folder would deploy; keep the guard even though
# portraits/_masters/ is now its home. depth/*.png is a level deeper and stays tracked.
apps/platform/public/images/Archetype imags/*.png
