# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (monorepo: match at any depth, not just root)
node_modules/
.pnp
.pnp.js

# testing
coverage/

# build output
build/
dist/
dist-app/

# monorepo tooling
.turbo/
.vite/

# misc
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
backend/.env

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local profiling scratch (Firefox profiles + analyzer)
tmp/

# Local data exports — contain personal data in the clear, never commit
exports/

# Desktop app: synced UI copy and packaged installers
apps/desktop/ui/
apps/desktop/release/
# …but its build resources (the app icon) are source, not output
!apps/desktop/build/
# Management app: same layout
apps/admin-desktop/ui/
apps/admin-desktop/release/
!apps/admin-desktop/build/

# The portrait INPUTS. All four served tiers live under apps/platform/public/images/Archetype imags/
# and ship with the site (owner, 2026-09-27); what stays out of git is only what feeds the ingest —
# see scripts/ingest-archetype-portraits.mjs:
#   portraits/_masters/   the ~23 MB PNG originals every tier is cut from
#   portraits/_incoming/  a delivery's own compressed copies
#   portraits/_depth/     the depth batch (see its README)
/portraits/
# A master dropped at the top of the shipped folder would deploy; keep the guard even though
# portraits/_masters/ is now its home. depth/*.png is a level deeper and stays tracked.
apps/platform/public/images/Archetype imags/*.png
