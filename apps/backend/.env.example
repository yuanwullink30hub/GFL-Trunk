# ── Server ──
PORT=8080

# ── MongoDB Atlas ──
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gardenforlife?retryWrites=true&w=majority

# ── JWT ──
JWT_SECRET=change-me-to-a-long-random-string

# ── AI Providers (set the ones you use) ──
OPENAI_API_KEY=sk-placeholder
GROK_API_KEY=placeholder
ANTHROPIC_API_KEY=placeholder

# ── Report pipeline ──
# v4.3 (default, live) or v5.2 (staged: runtime engine + sliced corpus + Master Prompt v5.2).
# Only after the six acceptance gates pass: `npm run test:gates` + `node scripts/engine-dry-run.js`.
REPORT_PIPELINE=v4.3

# ── Field-Level Encryption (AES-256-GCM) ──
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ── CORS ──
# Add your Render backend URL and Cloudflare Pages URL
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://gfl-trunk.pages.dev,https://gfl-api.onrender.com

# ── Stripe (payment for the full report) ──
# Both key sets may be present; STRIPE_MODE picks one (test | live, default test). Going live =
# STRIPE_MODE=live. Price IDs per mode come from `node scripts/stripe-setup.js` (tax-inclusive
# Prices, lookup keys essentie_launch / essentie_normal). Webhook secret per mode: the endpoint
# registered in that mode of the Dashboard (dev: `stripe listen --forward-to localhost:8080/api/payments/webhook`)
# — events: payment_intent.succeeded, payment_intent.processing, payment_intent.payment_failed,
# charge.refunded, charge.dispute.created. Accepted name variants: config/stripeEnv.js.
STRIPE_MODE=test
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_PUBLISHABLE_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_TEST_PRICE_LAUNCH=
STRIPE_TEST_PRICE_NORMAL=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_PUBLISHABLE_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
STRIPE_LIVE_PRICE_LAUNCH=
STRIPE_LIVE_PRICE_NORMAL=
# Production + STRIPE_MODE=test: payments only for requests with header X-GFL-Payments-Test: <this>.
PAYMENTS_TEST_TOKEN=

# ── Email (SMTP) ──
# For Gmail: use an App Password (not your regular password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yuanwullink30@gfl.community
SMTP_PASS=your-app-password-here
SMTP_FROM=yuanwullink30@gfl.community
