# ── Server ──
PORT=8080

# ── MongoDB Atlas ──
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gardenforlife?retryWrites=true&w=majority

# ── JWT ──
JWT_SECRET=change-me-to-a-long-random-string

# ── AI Providers (set the ones you use) ──
OPENAI_API_KEY=sk-placeholder
GROK_API_KEY=placeholder
ANTHROPIC_API_KEY=placeholder

# ── Field-Level Encryption (AES-256-GCM) ──
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ── CORS ──
# Add your Render backend URL and Cloudflare Pages URL
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://gfl-trunk.pages.dev,https://gfl-api.onrender.com

# ── Email (SMTP) ──
# For Gmail: use an App Password (not your regular password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yuanwullink30@gfl.community
SMTP_PASS=your-app-password-here
SMTP_FROM=yuanwullink30@gfl.community
