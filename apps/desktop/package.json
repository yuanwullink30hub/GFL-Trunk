{
  "name": "@gfl/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Garden For Life desktop app — the platform UI plus the local workstation folder",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron . --dev",
    "sync-ui": "node scripts/sync-ui.js",
    "start": "node scripts/sync-ui.js && electron .",
    "dist": "node scripts/sync-ui.js && electron-builder",
    "dist:win": "node scripts/sync-ui.js && electron-builder --win",
    "dist:mac": "node scripts/sync-ui.js && electron-builder --mac",
    "release": "node scripts/publish.js",
    "test": "node test/workspace.test.js && node test/account-and-report.test.js"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "2.16.3"
  }
}
