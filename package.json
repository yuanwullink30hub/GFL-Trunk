{
  "name": "gfl-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r --filter=\"./apps/*\" --filter=\"!@gfl/backend\" run build",
    "dev:platform": "pnpm --filter @gfl/platform dev",
    "dev:marketing": "pnpm --filter @gfl/marketing dev",
    "dev:admin": "pnpm --filter @gfl/admin dev",
    "dev:backend": "pnpm --filter @gfl/backend dev",
    "start:backend": "pnpm --filter @gfl/backend start",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "typescript": "^5.5.0"
  },
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom": "^0.8.15",
      "body-parser@<1.20.9": "^1.20.9",
      "dompurify": "^3.4.17",
      "fflate@<0.6.11": "0.6.11",
      "proxy-addr": "^2.0.8",
      "qs": "^6.16.1",
      "nanoid@<3.3.18": "^3.3.18",
      "postcss@<8.5.23": "^8.5.23",
      "postcss-selector-parser@<6.1.5": "^6.1.5",
      "browserslist@<4.28.7": "^4.28.7",
      "source-map-js@<1.2.2": "^1.2.2",
      "follow-redirects@<1.16.2": "^1.16.2"
    }
  }
}
